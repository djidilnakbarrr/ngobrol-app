{
  "rules": {
    "config": {
      "youtube": {
        ".read": true,
        ".write": "newData.exists() && root.child('users').child(newData.child('updatedBy').val()).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['apiKey', 'updatedBy', 'updatedAt'])",
        "apiKey": { ".validate": "newData.isString() && newData.val().length < 200" }
      }
    },
    "users": {
      "$uid": {
        "role": {
          ".validate": "(newData.val() === 'user' && data.val() !== 'admin') || (newData.val() === 'admin' && data.val() === 'admin')"
        }
      }
    }
  }
}
